# AttendAI Configuration Template
ENGINE_ORDER="gemini,claude"

# AttendAI Vision Cloud Providers
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.8-flash"

ANTHROPIC_API_KEY="your_anthropic_api_key_here"
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# Privacy: 'columns_only' or 'full_page'
PRIVACY_MODE="columns_only"
# Send printed Sr/Roll/Name to AI once on roster creation/crop (if false, requires CSV/XLSX upload)
SEND_NAMES_TO_AI=true
USE_YOLO=false
DEBUG=true
